# VCPeer Send — environment template for deploy/docker-compose.yml
# Copy to deploy/.env and fill in real values before deploying. Never commit
# the filled-in .env. Never AWS — storage is local disk or Cloudflare R2.

# --- App ---
VCPEER_SEND_URL=https://share.vcpeer.com

# --- SMTP (Scribase Mail — mail.scribase.com) ---
# These are also set in deploy/config.yaml; keep both in sync if you change one.
SMTP_HOST=mail.scribase.com
SMTP_PORT=587
SMTP_FROM=send@vcpeer.com
SMTP_USERNAME=REPLACE_WITH_SCRIBASE_MAIL_SMTP_USERNAME
SMTP_PASSWORD=REPLACE_WITH_SCRIBASE_MAIL_SMTP_PASSWORD

# --- Storage (optional: Cloudflare R2 instead of the local-disk default) ---
R2_ACCOUNT_ID=REPLACE_WITH_R2_ACCOUNT_ID
R2_ACCESS_KEY_ID=REPLACE_WITH_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=REPLACE_WITH_R2_SECRET_ACCESS_KEY
R2_BUCKET=vcpeer-send

# --- First admin (initUser block in config.yaml) ---
ADMIN_EMAIL=REPLACE_WITH_OWNER_EMAIL
ADMIN_PASSWORD=REPLACE_BEFORE_DEPLOY
